<head>
<meta charset="utf-8">
<style>
body { font-family: 'Times New Roman', serif; font-size: 13pt; margin: 2cm; }
h1 { text-align: center; font-size: 20pt; color: #1a1a2e; margin-bottom: 5px; }
h2 { font-size: 16pt; color: #16213e; border-bottom: 2px solid #0f3460; padding-bottom: 5px; margin-top: 25px; }
h3 { font-size: 14pt; color: #0f3460; margin-top: 15px; }
table { border-collapse: collapse; width: 100%; margin: 10px 0; }
th { background-color: #0f3460; color: white; padding: 8px 12px; text-align: left; border: 1px solid #0f3460; font-size: 12pt; }
td { padding: 8px 12px; border: 1px solid #ccc; font-size: 12pt; }
tr:nth-child(even) { background-color: #f2f2f2; }
.pass { color: #27ae60; font-weight: bold; }
.fail { color: #e74c3c; font-weight: bold; }
.warn { color: #f39c12; font-weight: bold; }
.header-info { text-align: center; color: #555; font-size: 12pt; margin-bottom: 20px; }
.section-green { background-color: #eafaf1; padding: 10px; border-left: 4px solid #27ae60; margin: 10px 0; }
.section-red { background-color: #fdedec; padding: 10px; border-left: 4px solid #e74c3c; margin: 10px 0; }
.section-blue { background-color: #eaf2f8; padding: 10px; border-left: 4px solid #2980b9; margin: 10px 0; }
ul { line-height: 1.8; }
</style>
</head>
